      "css": ".ds-nav{display:grid;gap:2px;width:188px;padding:8px 6px;background:var(--surface,#0b0e22);font-family:Geist,system-ui,sans-serif}.ds-nav-item{display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:6px;color:var(--text2,#a9aed0);font-size:13px;font-weight:500;text-decoration:none;transition:background-color .15s ease,color .15s ease}.ds-nav-item:hover{background:var(--surface2,#121633);color:var(--text,#eeeefa)}.ds-nav-item.is-active{background:rgba(160,124,240,.13);color:var(--accent,#a07cf0)}.ds-nav-item:focus-visible{outline:2px solid var(--accent2,#5cd3ea);outline-offset:3px}"
